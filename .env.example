# Copy to .env.local for local development.
# On Vercel: Project Settings → Environment Variables → add these for
# Production (and Preview if you want previews to send real email too).

# Resend API key — https://resend.com → API Keys.
RESEND_API_KEY=

# Where contact form submissions get delivered.
CONTACT_TO_EMAIL=you@example.com

# Must be an address on a domain you've verified in Resend.
# Resend's shared onboarding@resend.dev works for testing without a
# verified domain, but has low sending limits — verify your own domain
# before relying on this in production.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
